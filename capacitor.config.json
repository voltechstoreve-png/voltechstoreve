{
  "appId": "ve.voltech.store",
  "appName": "Voltech Store",
  "webDir": "public",
  "server": {
    "url": "https://www.voltechstoreve.com/portal?apk=1",
    "androidScheme": "https",
    "cleartext": false,
    "allowNavigation": ["*.voltechstoreve.com", "*.vercel.app"]
  },
  "android": {
    "webContentsDebuggingEnabled": false,
    "captureInput": true,
    "allowsLinkPreview": false,
    "preserveObjectReferences": true,
    "backgroundColor": "#0a0a0f"
  },
  "plugins": {
    "WebView": {
      "enableZoom": false,
      "mixedContentMode": "always"
    }
  }
}
